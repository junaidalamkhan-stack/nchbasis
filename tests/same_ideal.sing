// Consistency check: for each example, the left H-basis H returned by
// lhbasis generates the same left ideal as the input H0 (it contains H0,
// and every element of H lies in the left ideal generated by H0), and
// the initial form of every element of H lies in the omega-initial ideal
// generated by H (a necessary condition only; the H-basis property itself
// is the subject of Theorems 4.12 and 4.17 of the paper).
LIB "nchbasis.lib";
LIB "nctools.lib";
LIB "ncalg.lib";
option(noredefine);

proc sameLeftIdeal(list H0, list H)
{
  ideal I0, I; int i;
  for (i = 1; i <= size(H0); i++) { I0[i] = H0[i]; }
  for (i = 1; i <= size(H); i++)  { I[i]  = H[i]; }
  ideal s0 = std(I0); ideal s = std(I);
  int ok = (size(NF(I, s0)) == 0) && (size(NF(I0, s)) == 0);
  return(ok);
}

proc report(string name, list H0, intvec w)
{
  list H = lhbasis(H0, w);
  int i; int incl = 1;
  for (i = 1; i <= size(H0); i++) { incl = incl && (H[i] == H0[i]); }
  string s = name + ": " + string(size(H0)) + " -> " + string(size(H))
           + " generators; H0 is the start of H: " + string(incl)
           + "; same left ideal: " + string(sameLeftIdeal(H0, H));
  return(s);
}

ring r1 = 0, (x, d), dp; def A1 = Weyl(); setring A1;
list H0 = x^2*d + x, x*d + d^2;
report("Example 4.20 (A_1)", H0, intvec(1, -1));

def U = makeUsl2(); setring U;
list H0 = (e^2 + 1)*f, (e + h + 2)*f;
report("Example 4.21 (U(sl_2))", H0, intvec(1, -1, 0));
// the paper's basis and the library's basis generate the same left ideal A*f
list Hpaper = e^2*f + f, e*f + f*h, f*h^2 - 2*f*h + f, -f*h^3 + 6*f*h^2 - 9*f*h;
"Example 4.21: basis of the paper generates the same left ideal: " + string(sameLeftIdeal(H0, Hpaper));
"Example 4.21: f lies in the left ideal: " + string(NF(f, std(ideal(H0[1], H0[2]))) == 0);

ring r2 = 0, (x, y, dx, dy), dp; def A2 = Weyl(); setring A2;
list H0 = x*dy + dx, y*dx + dy;
report("Example 4.22 (A_2)", H0, intvec(1, 1, -1, -1));
quit;
