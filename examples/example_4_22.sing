// Example 4.22 of the paper: initial forms, syzygies of the initial forms
// and the left H-basis in the second Weyl algebra A_2, omega = (1,1,-1,-1).
LIB "nchbasis.lib";
LIB "nctools.lib";
option(noredefine);
ring R = 0, (x, y, dx, dy), dp;
def A2 = Weyl();           // dx*x = x*dx + 1, dy*y = y*dy + 1
setring A2;
intvec w = 1, 1, -1, -1;
list H0;
H0[1] = x*dy + dx;
H0[2] = y*dx + dy;
inform(H0[1], w); inform(H0[2], w);
module S = informSyzygies(H0, w);
S;
list H = lhbasis(H0, w);
H;
quit;
