// Example 4.20 of the paper: Algorithm 2 in the first Weyl algebra A_1,
// omega = (1,-1), H0 = {x^2*d + x, x*d + d^2}.  No adjunction: H = H0.
LIB "nchbasis.lib";
LIB "nctools.lib";
option(noredefine);
ring R = 0, (x, d), dp;
def A1 = Weyl();           // d*x = x*d + 1
setring A1;
intvec w = 1, -1;
list H0;
H0[1] = x^2*d + x;
H0[2] = x*d + d^2;
inform(H0[1], w); inform(H0[2], w);
list H = lhbasis(H0, w);
H;
quit;
